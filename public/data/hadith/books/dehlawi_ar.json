   "reference": {
    "book": 1,
    "hadith": 11
   }
  },
  {
   "number": 12,
   "arabic_number": 12,
   "text": "لَیْسَ مِنَّا مَنْ غَشَّنَا",
   "grades": [],
   "reference": {
    "book": 1,
    "hadith": 12
   }
  },
  {
   "number": 13,
   "arabic_number": 13,
   "text": "مَا قَلَّ وَكَفَى خَيْرٌ مِمَّا كَثُرَ وَأَلْهَى",
