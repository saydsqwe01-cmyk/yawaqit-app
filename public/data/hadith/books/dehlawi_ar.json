   "reference": {
    "book": 1,
    "hadith": 13
   }
  },
  {
   "number": 14,
   "arabic_number": 14,
   "text": "الرَّاجِعُ فِيْ هِبَتِهِ کَالرَّاجِعِ فِيْ قَیْئِهِ",
   "grades": [],
   "reference": {
